{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MediaTagger: Generate Xcode Project",
            "type": "shell",
            "command": "xcodegen generate",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "MediaTagger: Generate App Icon",
            "type": "shell",
            "command": "swift Scripts/generate_icon.swift",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "MediaTagger: Build (Debug)",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-project", "MediaTagger.xcodeproj",
                "-scheme", "MediaTagger",
                "-configuration", "Debug",
                "-destination", "platform=macOS,arch=arm64",
                "-derivedDataPath", "build",
                "CODE_SIGNING_ALLOWED=NO",
                "build"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "dependsOn": ["MediaTagger: Generate Xcode Project"],
            "problemMatcher": [
                {
                    "owner": "swift",
                    "fileLocation": ["absolute"],
                    "pattern": {
                        "regexp": "^(.+):(\\d+):(\\d+):\\s+(error|warning|note):\\s+(.+)$",
                        "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                    }
                }
            ]
        },
        {
            "label": "MediaTagger: Run",
            "type": "shell",
            "command": "open",
            "args": [
                "-W", "-n",
                "${workspaceFolder}/build/Build/Products/Debug/MediaTagger.app"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["MediaTagger: Build (Debug)"],
            "problemMatcher": []
        },
        {
            "label": "MediaTagger: Test",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-project", "MediaTagger.xcodeproj",
                "-scheme", "MediaTagger",
                "-destination", "platform=macOS,arch=arm64",
                "-derivedDataPath", "build",
                "CODE_SIGNING_ALLOWED=NO",
                "test"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": true },
            "dependsOn": ["MediaTagger: Generate Xcode Project"],
            "problemMatcher": []
        },
        {
            "label": "MediaTagger: Clean",
            "type": "shell",
            "command": "rm -rf build MediaTagger.xcodeproj",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
