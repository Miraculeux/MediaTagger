{
    "version": "0.2.0",
    "configurations": [
        {
            // Launches the app bundle directly (not via `open`), so VS Code's
            // process tree maps 1:1 to the running app — closing the window
            // ends the debug session immediately. Requires the Debug build to
            // disable Xcode's debug-dylib stub (see project.yml:
            // ENABLE_DEBUG_DYLIB_SUPPORT=NO, ENABLE_PREVIEWS=NO).
            "name": "Run MediaTagger",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/Build/Products/Debug/MediaTagger.app/Contents/MacOS/MediaTagger",
            "args": [],
            "cwd": "${workspaceFolder}",
            "terminal": "integrated",
            "preLaunchTask": "MediaTagger: Build (Debug)"
        },
        {
            "name": "Debug MediaTagger (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/Build/Products/Debug/MediaTagger.app/Contents/MacOS/MediaTagger",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "MediaTagger: Build (Debug)"
        }
    ]
}
