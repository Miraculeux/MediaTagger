{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run MediaTagger (open .app)",
            "type": "node-terminal",
            "request": "launch",
            "command": "open -W -n ${workspaceFolder}/build/Build/Products/Debug/MediaTagger.app",
            "preLaunchTask": "MediaTagger: Build (Debug)"
        },
        {
            "name": "Debug MediaTagger (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/Build/Products/Debug/MediaTagger.app/Contents/MacOS/MediaTagger",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "MediaTagger: Build (Debug)"
        }
    ]
}
